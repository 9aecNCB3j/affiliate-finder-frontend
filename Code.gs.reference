/**
 * Affiliate Finder — Google Apps Script Backend
 * Bound to spreadsheet: affiliate-sheet-bot
 *
 * Deploy: Extensions → Apps Script → Deploy → New deployment → Web app
 *   Execute as: Me
 *   Who has access: Anyone
 *
 * API (CORS-friendly):
 *   GET  ?action=search&q=หูฟัง&platform=lazada&topN=10
 *   POST text/plain JSON { action: "select", ...product }
 *   GET  ?action=select&data=<encodeURIComponent(JSON)>
 */

var PRODUCT_HEADERS = [
  'row_id', 'created_at', 'updated_at', 'platform', 'product_id', 'title', 'query',
  'search_id', 'price', 'original_price', 'discount_pct', 'commission_pct',
  'commission_amount', 'free_shipping', 'value_score', 'rank', 'selected_by_user',
  'product_url', 'affiliate_url', 'image_url', 'seller_name', 'category', 'status', 'notes'
];

var SEARCH_HEADERS = [
  'search_id', 'created_at', 'platform', 'query', 'results_returned',
  'top_product_ids', 'source', 'session_id'
];

var VIDEO_HEADERS = [
  'Video_ID', 'Platform', 'Video_URL', 'Product_Name', 'Affiliate_Link',
  'Cart_Status', 'Current_Views', 'Last_Updated'
];

var CONFIG_HEADERS = ['key', 'value', 'description'];

var DEFAULT_WEIGHTS = {
  price: 0.35,
  discount_pct: 0.25,
  commission: 0.25,
  free_shipping: 0.15
};

function doGet(e) {
  try {
    var p = (e && e.parameter) || {};
    var action = String(p.action || 'search').toLowerCase();

    if (action === 'health' || action === 'ping') {
      return json_({ ok: true, service: 'affiliate-finder-apps-script' });
    }

    if (action === 'select') {
      var raw = p.data || p.payload || '';
      var body = raw ? JSON.parse(decodeURIComponent(raw)) : {};
      return json_(handleSelect_(body));
    }

    return json_(handleSearch_({
      q: p.q || p.query || '',
      platform: p.platform || '',
      topN: p.topN || p.top_n || '',
      session_id: p.session_id || '',
      persist: p.persist
    }));
  } catch (err) {
    return json_({ error: String(err && err.message ? err.message : err) }, 400);
  }
}

function doPost(e) {
  try {
    var body = {};
    if (e && e.postData && e.postData.contents) {
      var text = String(e.postData.contents);
      try {
        body = JSON.parse(text);
      } catch (parseErr) {
        // form-urlencoded fallback
        body = (e.parameter) || {};
      }
    } else {
      body = (e && e.parameter) || {};
    }

    var action = String(body.action || 'select').toLowerCase();
    if (action === 'search') {
      return json_(handleSearch_(body));
    }
    return json_(handleSelect_(body));
  } catch (err) {
    return json_({ error: String(err && err.message ? err.message : err) }, 400);
  }
}

function doOptions() {
  return ContentService.createTextOutput('')
    .setMimeType(ContentService.MimeType.TEXT);
}

/* -------------------- Search -------------------- */

function handleSearch_(input) {
  ensureSheets_();
  // ล้างแถว recommended เก่าก่อนอ่าน — ค้นหาเร็วขึ้นเมื่อชีตไม่บวม
  pruneRecommendedProducts_();

  var query = String(input.q || input.query || '').trim();
  var platform = String(input.platform || getConfig_('platform_default', 'lazada')).toLowerCase();
  var topN = Math.min(Number(input.topN || input.top_n || getConfig_('top_n', '10')) || 10, 10);
  var persist = String(input.persist == null ? 'false' : input.persist).toLowerCase() === 'true';
  var sessionId = String(input.session_id || '');

  if (!query) {
    throw new Error('ต้องระบุคำค้นหา q');
  }

  // 1) ชีต (ชื่อต้องเกี่ยวกับคำค้น)  2) คลัง fallback ที่ชื่อเกี่ยวกับคำค้นเท่านั้น
  var candidates = findCandidates_(query, platform).filter(function (p) {
    return titleMatchesQuery_(p.title, query);
  });
  if (candidates.length < topN) {
    candidates = mergeCandidates_(candidates, generateCatalog_(query, platform, topN));
  }

  var weights = getWeights_();
  var products = scoreProducts_(candidates, weights).slice(0, topN);
  products = products.map(function (p) {
    if (!p.source) p.source = 'catalog';
    p.image_url = '';
    return p;
  });

  var searchId = uuid_();
  var createdAt = nowIso_();

  // ค่าเริ่มต้นไม่ persist — บันทึกตอนกดเลือกสินค้า (เร็วขึ้นมาก)
  if (persist) {
    appendRow_('searches', SEARCH_HEADERS, {
      search_id: searchId,
      created_at: createdAt,
      platform: platform,
      query: query,
      results_returned: products.length,
      top_product_ids: products.map(function (p) { return p.product_id; }).join('|'),
      source: products.length && products[0].source ? products[0].source : 'catalog',
      session_id: sessionId
    });

    var productRows = products.map(function (p) {
      return {
        row_id: uuid_(),
        created_at: createdAt,
        updated_at: createdAt,
        platform: p.platform,
        product_id: p.product_id,
        title: p.title,
        query: query,
        search_id: searchId,
        price: p.price,
        original_price: p.original_price,
        discount_pct: p.discount_pct,
        commission_pct: p.commission_pct,
        commission_amount: p.commission_amount,
        free_shipping: boolCell_(p.free_shipping),
        value_score: p.value_score,
        rank: p.rank,
        selected_by_user: 'FALSE',
        product_url: p.product_url,
        affiliate_url: '',
        image_url: p.image_url,
        seller_name: p.seller_name,
        category: p.category,
        status: p.status || 'active',
        notes: 'recommended'
      };
    });
    appendRows_('products', PRODUCT_HEADERS, productRows);
  }

  return {
    search_id: searchId,
    query: query,
    platform: platform,
    count: products.length,
    products: products
  };
}

/** คลังสินค้า seed สำหรับสร้างผลค้นหาตามคำค้น (fallback เมื่อชีตว่าง / ไม่พอ) */
var CATALOG_SEED_ = [
  { base: 'หูฟังบลูทูธ ANC Pro', category: 'Electronics', seller: 'AudioMall Official' },
  { base: 'หูฟังไร้สาย Sport Lite', category: 'Electronics', seller: 'FitSound TH' },
  { base: 'หูฟังครอบหู Bass Boost', category: 'Electronics', seller: 'SoundHub' },
  { base: 'หูฟังมินิ Clip Buds', category: 'Electronics', seller: 'DailyGadget' },
  { base: 'หูฟังเกมมิ่ง RGB', category: 'Electronics', seller: 'ProGamer Store' },
  { base: 'ลำโพงพกพา Waterproof', category: 'Electronics', seller: 'BoomBox TH' },
  { base: 'สายชาร์จเร็ว 65W', category: 'Accessories', seller: 'ChargeLab' },
  { base: 'พาวเวอร์แบงก์ 20000mAh', category: 'Accessories', seller: 'PowerGo' },
  { base: 'เมาส์ไร้สาย Silent', category: 'Electronics', seller: 'OfficePro' },
  { base: 'คีย์บอร์ดแมคคานิคอล', category: 'Electronics', seller: 'KeyCraft' },
  { base: 'รองเท้าผ้าใบเบา Running', category: 'Fashion', seller: 'StepUp Store' },
  { base: 'รองเท้าผ้าใบคลาสสิก', category: 'Fashion', seller: 'UrbanWalk' },
  { base: 'รองเท้าผ้าใบกันน้ำ', category: 'Fashion', seller: 'TrailMate' },
  { base: 'กระติกน้ำเก็บความเย็น', category: 'Home', seller: 'ThermoHome' },
  { base: 'หม้อทอดไร้น้ำมัน', category: 'Home', seller: 'KitchenPlus' },
  { base: 'เสื้อยืดคอกลม Cotton', category: 'Fashion', seller: 'BasicWear' },
  { base: 'กระเป๋าเป้กันน้ำ', category: 'Fashion', seller: 'PackGo' },
  { base: 'ครีมกันแดด SPF50', category: 'Beauty', seller: 'SkinCare TH' },
  { base: 'วิตามินซีเม็ดเคี้ยว', category: 'Health', seller: 'HealthPlus' },
  { base: 'สายรัดข้อมือ Smart Band', category: 'Electronics', seller: 'WearTech' },
  { base: 'พัดลมตั้งโต๊ะ 16 นิ้ว', category: 'Home', seller: 'CoolBreeze TH' },
  { base: 'พัดลม USB พกพา', category: 'Home', seller: 'AirFlow Shop' }
];

function mergeCandidates_(existing, extra) {
  var seen = {};
  var out = [];
  (existing || []).forEach(function (p) {
    if (!p || !p.product_id) return;
    var id = String(p.product_id);
    if (seen[id]) return;
    seen[id] = true;
    out.push(p);
  });
  (extra || []).forEach(function (p) {
    if (!p || !p.product_id) return;
    var id = String(p.product_id);
    if (seen[id]) return;
    seen[id] = true;
    out.push(p);
  });
  return out;
}

function hashSeed_(input) {
  var raw = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(input), Utilities.Charset.UTF_8);
  var out = [];
  for (var i = 0; i < raw.length; i++) {
    var b = raw[i];
    out.push(b < 0 ? b + 256 : b);
  }
  return out;
}

function pickInt_(buf, offset, min, max) {
  var n = buf[offset % buf.length];
  return min + (n % (max - min + 1));
}

/** ส่วนขยายชื่อเมื่อคำค้นไม่อยู่ในคลัง seed — ชื่อต้องเกี่ยวกับคำค้นเท่านั้น */
var QUERY_TITLE_SUFFIXES_ = [
  'พรีเมียม', 'สูตรอ่อนโยน', 'แพ็คคุ้ม', 'ขนาดพกพา', 'ออร์แกนิก',
  'กลิ่นหอม', 'เซ็ตคู่', 'รีฟิล', 'ยอดนิยม', 'ใช้ประจำวัน'
];

var QUERY_SELLERS_ = [
  'DailyMart TH', 'HomeCare Official', 'CleanPlus', 'ValueShop', 'SoftLife Store'
];

/**
 * สร้างรายการสินค้าตามคำค้น (Top N) — ชื่อต้องเกี่ยวกับคำค้นเท่านั้น ไม่ผสมสินค้าคนละหมวด
 */
function generateCatalog_(query, platform, limitPool) {
  var q = String(query || '').trim();
  if (!q) return [];
  var want = Math.max(1, Number(limitPool) || 10);
  var seed = hashSeed_(String(platform) + ':' + q.toLowerCase());
  var qLower = q.toLowerCase();
  var tokens = tokenize_(q);

  var matched = CATALOG_SEED_.filter(function (item) {
    var base = String(item.base || '').toLowerCase();
    return tokens.every(function (t) { return base.indexOf(t) !== -1; });
  });

  var commissionDefault = Number(getConfig_('default_commission_pct', '5')) || 5;
  var out = [];
  for (var idx = 0; idx < want; idx++) {
    var original_price = pickInt_(seed, idx * 3, 399, 2490);
    var discount_pct = Number((pickInt_(seed, idx * 3 + 1, 15, 55) + (idx % 20)).toFixed(1));
    var price = Math.round(original_price * (1 - discount_pct / 100));
    var commission_pct = Number((pickInt_(seed, idx * 3 + 2, 4, 12) + (idx % 3)).toFixed(1)) || commissionDefault;
    var free_shipping = pickInt_(seed, idx + 7, 0, 1) === 1 || idx < 2;
    var product_id = String(1000000000 + pickInt_(seed, idx * 5, 100000, 899999999) + idx);

    var title;
    var seller;
    var category;
    if (matched.length) {
      var item = matched[idx % matched.length];
      title = item.base + (idx >= matched.length ? ' #' + (idx + 1) : '');
      seller = item.seller;
      category = item.category;
    } else {
      var suffix = QUERY_TITLE_SUFFIXES_[idx % QUERY_TITLE_SUFFIXES_.length];
      title = q + ' ' + suffix + (idx >= QUERY_TITLE_SUFFIXES_.length ? ' #' + (idx + 1) : '');
      seller = QUERY_SELLERS_[idx % QUERY_SELLERS_.length];
      category = 'General';
    }

    out.push({
      platform: platform || 'lazada',
      product_id: product_id,
      title: title,
      price: price,
      original_price: original_price,
      discount_pct: discount_pct,
      commission_pct: commission_pct,
      commission_amount: Number(((price * commission_pct) / 100).toFixed(2)),
      free_shipping: free_shipping,
      product_url: 'https://www.lazada.co.th/products/pdp-i' + product_id + '.html',
      image_url: '',
      seller_name: seller,
      category: category,
      status: 'active',
      source: 'catalog'
    });
  }
  return out;
}

/** ชื่อสินค้าต้องมีทุก token ของคำค้น */
function titleMatchesQuery_(title, query) {
  var tokens = tokenize_(query);
  if (!tokens.length) return false;
  var hay = String(title || '').toLowerCase();
  return tokens.every(function (t) { return hay.indexOf(t) !== -1; });
}

/**
 * ค้นจากชีต products (+ catalog ถ้ามี) ตามคำค้น แล้ว dedupe ตาม product_id
 */
function findCandidates_(query, platform) {
  var tokens = tokenize_(query);
  var rows = readObjects_('products', PRODUCT_HEADERS);

  var catalogSheet = SpreadsheetApp.getActive().getSheetByName('catalog');
  if (catalogSheet) {
    rows = rows.concat(readObjects_('catalog', PRODUCT_HEADERS));
  }

  var bestById = {};
  rows.forEach(function (r) {
    var pPlatform = String(r.platform || '').toLowerCase();
    if (platform && pPlatform && pPlatform !== platform) return;

    // จับคู่จากชื่อสินค้า (+ หมวด) เท่านั้น — ไม่ใช้คอลัมน์ query (เคยทำให้ผลผิดหมวด)
    var hay = [r.title, r.category].join(' ').toLowerCase();
    if (!tokens.every(function (t) { return hay.indexOf(t) !== -1; })) return;

    var id = String(r.product_id || '').trim();
    if (!id) return;

    var product = normalizeProduct_(r, platform);
    var prev = bestById[id];
    if (!prev || Number(product.price) > 0) {
      // keep newest / richer row
      if (!prev || String(r.updated_at || r.created_at) > String(prev._ts || '')) {
        product._ts = r.updated_at || r.created_at || '';
        bestById[id] = product;
      }
    }
  });

  return Object.keys(bestById).map(function (k) {
    var p = bestById[k];
    delete p._ts;
    return p;
  });
}

function normalizeProduct_(r, platform) {
  var price = Number(r.price) || 0;
  var original = Number(r.original_price) || 0;
  var discount = Number(r.discount_pct);
  if (!discount && original > price && original > 0) {
    discount = Number((((original - price) / original) * 100).toFixed(1));
  }
  var commissionPct = Number(r.commission_pct) || 0;
  var commissionAmount = Number(r.commission_amount);
  if (!commissionAmount && price && commissionPct) {
    commissionAmount = Number(((price * commissionPct) / 100).toFixed(2));
  }
  var productUrl = String(r.product_url || '').trim();
  var productId = String(r.product_id || '').trim();
  if (!productUrl && productId) {
    productUrl = 'https://www.lazada.co.th/products/pdp-i' + productId + '.html';
  }

  return {
    platform: String(r.platform || platform || 'lazada').toLowerCase(),
    product_id: productId,
    title: String(r.title || ''),
    price: price,
    original_price: original,
    discount_pct: discount || 0,
    commission_pct: commissionPct,
    commission_amount: commissionAmount || 0,
    free_shipping: isTrue_(r.free_shipping),
    product_url: productUrl,
    image_url: '',
    seller_name: String(r.seller_name || ''),
    category: String(r.category || ''),
    status: String(r.status || 'active'),
    source: 'sheet'
  };
}

/* -------------------- Select / Affiliate -------------------- */

function handleSelect_(body) {
  ensureSheets_();
  body = body || {};
  var productId = String(body.product_id || '').trim();
  var title = String(body.title || '').trim();
  var productUrl = String(body.product_url || '').trim();
  var platform = String(body.platform || getConfig_('platform_default', 'lazada')).toLowerCase();

  if (!productId || !title || !productUrl) {
    throw new Error('ต้องมี product_id, title, product_url');
  }

  var converted = toAffiliateLink_(platform, productUrl, productId);
  var ts = nowIso_();
  var rowId = uuid_();
  var platformLabel =
    platform === 'shopee' ? 'Shopee' : platform === 'tiktok' ? 'TikTok' : 'Lazada';

  var productRow = {
    row_id: rowId,
    created_at: ts,
    updated_at: ts,
    platform: platform,
    product_id: productId,
    title: title,
    query: body.query || '',
    search_id: body.search_id || '',
    price: body.price != null ? body.price : '',
    original_price: body.original_price != null ? body.original_price : '',
    discount_pct: body.discount_pct != null ? body.discount_pct : '',
    commission_pct: body.commission_pct != null ? body.commission_pct : '',
    commission_amount: body.commission_amount != null ? body.commission_amount : '',
    free_shipping: boolCell_(body.free_shipping),
    value_score: body.value_score != null ? body.value_score : '',
    rank: body.rank != null ? body.rank : '',
    selected_by_user: 'TRUE',
    product_url: productUrl,
    affiliate_url: converted.affiliateUrl,
    image_url: body.image_url || '',
    seller_name: body.seller_name || '',
    category: body.category || '',
    status: 'active',
    notes: 'selected via Apps Script (' + converted.mode + '/' + converted.provider + ')'
  };

  appendRow_('products', PRODUCT_HEADERS, productRow);

  appendRow_('Video_Monitoring', VIDEO_HEADERS, {
    Video_ID: 'SEL-' + productId,
    Platform: platformLabel,
    Video_URL: productUrl,
    Product_Name: title,
    Affiliate_Link: converted.affiliateUrl,
    Cart_Status: 'ปกติ',
    Current_Views: 0,
    Last_Updated: ts.replace('T', ' ').replace('+07:00', '')
  });

  return {
    ok: true,
    row_id: rowId,
    affiliate_url: converted.affiliateUrl,
    affiliate_mode: converted.mode,
    provider: converted.provider,
    warning: converted.warning || undefined,
    product: productRow
  };
}

function toAffiliateLink_(platform, productUrl, productId) {
  var cleanUrl = normalizeProductUrl_(productUrl, productId);
  var p = String(platform || 'lazada').toLowerCase();

  if (p === 'lazada') {
    var offerCode = String(getConfig_('lazada_offer_code', '')).trim();
    var memberId = String(getConfig_('lazada_member_id', '')).trim();
    var subId = String(getConfig_('lazada_sub_id', 'aff-finder')).trim() || 'aff-finder';

    if (offerCode && offerCode !== 'demo-aff') {
      var u = 'https://c.lazada.co.th/t/c.' + encodeURIComponent(offerCode) +
        '?url=' + encodeURIComponent(cleanUrl) +
        (productId ? '&itemId=' + encodeURIComponent(productId) : '') +
        '&sub_id=' + encodeURIComponent(subId);
      if (memberId) u += '&aff_id=' + encodeURIComponent(memberId);
      return {
        affiliateUrl: u,
        mode: 'live',
        provider: 'lazada-offer'
      };
    }

    var direct = cleanUrl;
    var sep = direct.indexOf('?') >= 0 ? '&' : '?';
    if (memberId) direct += sep + 'laz_aff_id=' + encodeURIComponent(memberId) + '&sub_aff_id=' + encodeURIComponent(subId);
    else direct += sep + 'sub_aff_id=' + encodeURIComponent(subId);

    return {
      affiliateUrl: direct,
      mode: 'live',
      provider: 'lazada-direct',
      warning: 'ยังไม่มี lazada_offer_code ในชีต config — ใส่ค่าจาก Lazada Affiliate เพื่อได้ลิงก์ track จริง'
    };
  }

  if (p === 'shopee') {
    var tracking = getConfig_('affiliate_tracking_id', 'demo-aff');
    var base = getConfig_('shopee_affiliate_base', 'https://s.shopee.co.th/');
    return {
      affiliateUrl: base + encodeURIComponent(tracking) + '?url=' + encodeURIComponent(cleanUrl),
      mode: 'sheet',
      provider: 'shopee'
    };
  }

  return { affiliateUrl: cleanUrl, mode: 'passthrough', provider: p };
}

function normalizeProductUrl_(productUrl, productId) {
  var raw = String(productUrl || '').trim();
  if (/^https?:\/\/(www\.)?lazada\.co\.th\//i.test(raw) && /i\d+/i.test(raw)) {
    return raw.split('?')[0];
  }
  if (productId && /^\d+$/.test(String(productId))) {
    return 'https://www.lazada.co.th/products/pdp-i' + productId + '.html';
  }
  return raw;
}

/* -------------------- Scoring -------------------- */

function scoreProducts_(products, weights) {
  weights = weights || DEFAULT_WEIGHTS;
  if (!products.length) return [];

  var prices = products.map(function (p) { return Number(p.price) || 0; });
  var discounts = products.map(function (p) { return Number(p.discount_pct) || 0; });
  var commissions = products.map(function (p) { return Number(p.commission_pct) || 0; });

  var minPrice = Math.min.apply(null, prices);
  var maxPrice = Math.max.apply(null, prices);
  var minDisc = Math.min.apply(null, discounts);
  var maxDisc = Math.max.apply(null, discounts);
  var minComm = Math.min.apply(null, commissions);
  var maxComm = Math.max.apply(null, commissions);

  function normHigh(v, min, max) {
    return max === min ? 100 : ((v - min) / (max - min)) * 100;
  }
  function normLow(v, min, max) {
    return max === min ? 100 : ((max - v) / (max - min)) * 100;
  }

  var scored = products.map(function (p) {
    var priceScore = normLow(Number(p.price) || 0, minPrice, maxPrice);
    var discountScore = normHigh(Number(p.discount_pct) || 0, minDisc, maxDisc);
    var commissionScore = normHigh(Number(p.commission_pct) || 0, minComm, maxComm);
    var shipScore = p.free_shipping ? 100 : 0;
    var value_score = Number((
      weights.price * priceScore +
      weights.discount_pct * discountScore +
      weights.commission * commissionScore +
      weights.free_shipping * shipScore
    ).toFixed(1));
    var out = {};
    Object.keys(p).forEach(function (k) { out[k] = p[k]; });
    out.value_score = value_score;
    return out;
  });

  scored.sort(function (a, b) { return b.value_score - a.value_score; });
  return scored.map(function (p, i) {
    p.rank = i + 1;
    return p;
  });
}

function getWeights_() {
  return {
    price: Number(getConfig_('weight_price', DEFAULT_WEIGHTS.price)),
    discount_pct: Number(getConfig_('weight_discount_pct', DEFAULT_WEIGHTS.discount_pct)),
    commission: Number(getConfig_('weight_commission', DEFAULT_WEIGHTS.commission)),
    free_shipping: Number(getConfig_('weight_free_shipping', DEFAULT_WEIGHTS.free_shipping))
  };
}

/* -------------------- Sheet helpers -------------------- */

function ensureSheets_() {
  ensureSheet_('products', PRODUCT_HEADERS);
  ensureSheet_('searches', SEARCH_HEADERS);
  ensureSheet_('Video_Monitoring', VIDEO_HEADERS);
  var config = ensureSheet_('config', CONFIG_HEADERS);
  seedConfig_(config);
}

function ensureSheet_(name, headers) {
  var ss = SpreadsheetApp.getActive();
  var sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
    return sheet;
  }
  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
  } else {
    var existing = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), headers.length)).getValues()[0];
    var needHeaders = !existing || !existing[0];
    if (needHeaders) {
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    }
  }
  return sheet;
}

function seedConfig_(sheet) {
  var map = readConfigMap_();
  var seeds = [
    ['platform_default', 'lazada', 'แพลตฟอร์มเริ่มต้น'],
    ['top_n', '10', 'จำนวนสินค้าคุ้มค่าที่คืนต่อคำค้น'],
    ['weight_price', '0.35', 'น้ำหนักคะแนนราคาถูก'],
    ['weight_discount_pct', '0.25', 'น้ำหนักคะแนนส่วนลด %'],
    ['weight_commission', '0.25', 'น้ำหนักคะแนนค่าคอม'],
    ['weight_free_shipping', '0.15', 'น้ำหนักคะแนนส่งฟรี'],
    ['currency', 'THB', 'สกุลเงิน'],
    ['lazada_offer_code', '', 'รหัส offer จาก Lazada Affiliate (c.lazada.co.th/t/c.XXX)'],
    ['lazada_member_id', '', 'Affiliate member id'],
    ['lazada_sub_id', 'aff-finder', 'sub_id สำหรับ track']
  ];
  var toAdd = [];
  seeds.forEach(function (row) {
    if (!(row[0] in map)) toAdd.push(row);
  });
  if (toAdd.length) {
    sheet.getRange(sheet.getLastRow() + 1, 1, toAdd.length, 3).setValues(toAdd);
  }
  // อัปเดต top_n เก่า (50) → 10
  if (String(map.top_n || '') === '50') {
    setConfigValue_(sheet, 'top_n', '10');
  }
}

function setConfigValue_(sheet, key, value) {
  if (!sheet || sheet.getLastRow() < 2) return;
  var values = sheet.getRange(2, 1, sheet.getLastRow(), 2).getValues();
  for (var i = 0; i < values.length; i++) {
    if (String(values[i][0]) === key) {
      sheet.getRange(i + 2, 2).setValue(value);
      return;
    }
  }
}

function readConfigMap_() {
  var sheet = SpreadsheetApp.getActive().getSheetByName('config');
  var map = {};
  if (!sheet || sheet.getLastRow() < 2) return map;
  var values = sheet.getRange(2, 1, sheet.getLastRow(), 2).getValues();
  values.forEach(function (row) {
    if (row[0]) map[String(row[0])] = String(row[1] == null ? '' : row[1]);
  });
  return map;
}

function getConfig_(key, fallback) {
  var map = readConfigMap_();
  if (key in map && map[key] !== '') return map[key];
  return fallback;
}

function readObjects_(sheetName, headers) {
  var sheet = SpreadsheetApp.getActive().getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() < 2) return [];
  var width = Math.max(sheet.getLastColumn(), headers.length);
  var values = sheet.getRange(1, 1, sheet.getLastRow(), width).getValues();
  var head = values[0].map(function (h) { return String(h || '').trim(); });
  var out = [];
  for (var i = 1; i < values.length; i++) {
    var row = values[i];
    if (!row.join('')) continue;
    var obj = {};
    headers.forEach(function (h) {
      var idx = head.indexOf(h);
      obj[h] = idx >= 0 ? row[idx] : '';
    });
    out.push(obj);
  }
  return out;
}

function appendRow_(sheetName, headers, obj) {
  appendRows_(sheetName, headers, [obj]);
}

/** เขียนหลายแถวครั้งเดียว (เร็วกว่า appendRow ทีละแถว) */
function appendRows_(sheetName, headers, objects) {
  if (!objects || !objects.length) return;
  var sheet = ensureSheet_(sheetName, headers);
  var rows = objects.map(function (obj) {
    return headers.map(function (h) {
      return obj[h] != null ? obj[h] : '';
    });
  });
  var start = sheet.getLastRow() + 1;
  sheet.getRange(start, 1, rows.length, headers.length).setValues(rows);
}

/**
 * ลบแถว products ที่สะสมจากการค้นหา — คงไว้เฉพาะที่ผู้ใช้เลือกแล้ว
 */
function pruneRecommendedProducts_() {
  var sheet = SpreadsheetApp.getActive().getSheetByName('products');
  if (!sheet || sheet.getLastRow() < 2) return;

  var width = Math.max(sheet.getLastColumn(), PRODUCT_HEADERS.length);
  var values = sheet.getRange(1, 1, sheet.getLastRow(), width).getValues();
  var head = values[0].map(function (h) { return String(h || '').trim(); });
  var idxSelected = head.indexOf('selected_by_user');
  if (idxSelected < 0) return;

  var keep = [values[0]];
  for (var i = 1; i < values.length; i++) {
    var row = values[i];
    if (!row.join('')) continue;
    if (isTrue_(row[idxSelected])) keep.push(row);
  }

  if (keep.length === values.length) return;

  sheet.clearContents();
  sheet.getRange(1, 1, keep.length, width).setValues(keep);
}

/* -------------------- Utils -------------------- */

function json_(obj, optStatus) {
  // ContentService cannot set HTTP status reliably for web apps; embed error in body.
  var out = ContentService.createTextOutput(JSON.stringify(obj));
  out.setMimeType(ContentService.MimeType.JSON);
  return out;
}

function nowIso_() {
  return Utilities.formatDate(new Date(), 'Asia/Bangkok', "yyyy-MM-dd'T'HH:mm:ss'+07:00'");
}

function uuid_() {
  return Utilities.getUuid();
}

function boolCell_(v) {
  return isTrue_(v) ? 'TRUE' : 'FALSE';
}

function isTrue_(v) {
  if (v === true || v === 1) return true;
  var s = String(v == null ? '' : v).trim().toUpperCase();
  return s === 'TRUE' || s === '1' || s === 'YES';
}

function tokenize_(query) {
  return String(query || '')
    .toLowerCase()
    .split(/[\s,;/|]+/)
    .map(function (t) { return t.trim(); })
    .filter(function (t) { return t.length > 0; });
}

/**
 * เมนูช่วยใน Sheet: รันครั้งเดียวเพื่อสร้างหัวตาราง + config
 */
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Affiliate Finder')
    .addItem('เตรียมชีต (headers + config)', 'ensureSheets_')
    .addToUi();
}
